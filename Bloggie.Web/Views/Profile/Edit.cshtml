@model Bloggie.Web.Models.ViewModels.ProfileViewModel

<div class="container">
    <h2 class="mb-4">Chỉnh sửa thông tin</h2>
    <form asp-action="Edit" method="post">
        <div class="form-group">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DateOfBirth"></label>
            <input asp-for="DateOfBirth" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Address"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Education"></label>
            <textarea asp-for="Education" class="form-control"></textarea>
            <span asp-validation-for="Education" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="WorkExperience"></label>
            <textarea asp-for="WorkExperience" class="form-control"></textarea>
            <span asp-validation-for="WorkExperience" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Skills"></label>
            <textarea asp-for="Skills" class="form-control"></textarea>
            <span asp-validation-for="Skills" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}